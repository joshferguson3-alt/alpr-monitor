# Copy to .env and fill in. Never commit .env or real keys.
# GitHub Actions reads these from repository secrets.

# Classifier. Current low-cost model id (verified 2026-11-12): claude-haiku-5-5
ANTHROPIC_API_KEY=

# Notion integration. API version used by this repo: 2026-03-11
NOTION_TOKEN=
# Parent page the setup script creates the two databases under.
NOTION_PARENT_PAGE_ID=4164f0a3a2cd815bb7d9e828b157b6bd
# Printed by scripts/setup_notion.py. The daily run reads these.
NOTION_SIGNALS_DB_ID=
NOTION_AGENCIES_DB_ID=

# Free legislative and court APIs. A collector with a missing key logs
# "missing key, skipped" and the run continues.
LEGISCAN_API_KEY=
OPENSTATES_API_KEY=
CONGRESS_API_KEY=
COURTLISTENER_TOKEN=

# Digest email. SMTP through Gmail. The message is sent only to DIGEST_TO,
# and only when that address is josh.ferguson3@gmail.com.
SMTP_USER=josh.ferguson3@gmail.com
SMTP_APP_PASSWORD=
DIGEST_TO=josh.ferguson3@gmail.com
